{
  "name": "isaacprof-viewer",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "type": "module",
  "version": "0.11.8",
  "scripts": {
    "dev": "node scripts/dev.mts",
    "typecheck": "node node_modules/typescript-compiler/bin/tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint",
    "build": "pnpm check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "analyze": "node scripts/analyze.mts",
    "format": "prettier --write \"**/*.{ts,tsx,mts}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mts}\""
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-compiler": "npm:typescript@7.0.2",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4"
  }
}
